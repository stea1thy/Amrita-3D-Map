{
  "$schema_version": "1.2",
  "_documentation": {
    "description": "Manual overrides for OSM campus features, exclusions, skybridges, custom roads, and missing structures.",
    "categories": [
      "academic",
      "hostel",
      "food",
      "sports",
      "admin",
      "landmark"
    ],
    "osm_id_format": "<way|relation>/<numeric_id>, matching properties.osm_id in data/raw_osm.json",
    "exclude_ids": "List of OSM IDs to skip completely during extrusion (for junk/stray polygons)",
    "bridges": "List of elevated skybridges ({ id, name, from: [lat, lon], to: [lat, lon], width, bottomY, height, color, roofColor } or { id, osm_id, bottomY / min_height, height, color, roofColor }) rendered floating above ground clearance",
    "rename_or_retag": "Map OSM ID -> { name, subtitle (optional), category, floors (optional), height_m (optional), min_height (optional), bottomY (optional), tags (optional list), departments (optional list) }",
    "shift_footprints": "Map OSM ID -> [dx_meters, dz_meters] in local 3D world space (+X East, +Z South / -Z North)",
    "footbridges": "Raised pedestrian bridges ({ id, name, points: [[lat, lon], ...] with ground-level ends, width, clearance, roof }) built by heroes/footbridge.py and routed by build_graph.py",
    "custom_buildings": "List of manual buildings missing from OSM, each with footprint as [[lat, lon], ...] polygon ring",
    "custom_roads": "List of custom campus road/footpath polylines missing from OSM ({ id, name, subtype, points: [[lat, lon], ...], render (optional) }) rendered & routed alongside OSM roads; render: false routes along paving another model already draws",
    "category_colors": "Optional map of category -> hex color string (e.g. '#E6DDD0') overriding default palette colors"
  },
